    "spec": "# Login Form — Feature Task\nGoal: User email aur password se safely sign in kar sake.\n## Required components\n- Welcome back (heading) — Form heading\n- Email (input) — Email input with label\n- Password (input) — Password input with label\n- Sign In (button) — Submit button\n- Forgot password? (text) — Recovery link text\n## Interactions\n- Empty email par error dikhe\n- Sign In click par loading state aaye\n## Acceptance criteria\n- Har input ke saath label ho\n- Password field type password ho\n- Error message screen reader ko mile",
    "code": "<section class=\"card\" aria-label=\"Login Form\">\n      <h2>Welcome back</h2>\n      <label for=\"email\">Email</label><input id=\"email\" type=\"email\" aria-label=\"Email\" />\n      <label for=\"password\">Password</label><input id=\"password\" type=\"password\" aria-label=\"Password\" />\n      <button type=\"button\" data-action=\"sign-in\">Sign In</button>\n      <p>Forgot password?</p>\n    </section>\n\n<style>\n.card{max-width:420px;border:1px solid #e4e7ec;border-radius:20px;padding:20px;font-family:system-ui}\n.card button{background:#2563eb;color:#fff;border:0;border-radius:12px;padding:11px 14px;font-weight:800}\n.card input{width:100%;padding:11px;border:1px solid #e4e7ec;border-radius:12px}\n.badge{background:#eff6ff;color:#1d4ed8;border-radius:999px;padding:5px 9px;font-weight:800}\n.progress{height:10px;background:#eef2ff;border-radius:999px;overflow:hidden}.progress i{display:block;height:100%;background:#2563eb}\n@media(max-width:520px){.card{max-width:100%}}\n</style>\n\n<script>\ndocument.querySelector('[data-action]')?.addEventListener('click', () => {\n  document.body.dataset.lastAction = 'clicked';\n});\n</script>",
    "tests": "import { test, expect } from '@playwright/test';\n\ntest('Login Form matches the mockup task', async ({ page }) => {\n  await page.goto('/');\n  await expect(page.getByText('Welcome back')).toBeVisible();\n  await expect(page.getByLabel('Email')).toBeVisible();\n  await expect(page.getByLabel('Password')).toBeVisible();\n  await expect(page.getByRole('button', { name: 'Sign In' })).toBeVisible();\n  await expect(page.getByText('Forgot password?')).toBeVisible();\n});\n\ntest('primary action responds', async ({ page }) => {\n  await page.goto('/');\n  await page.getByRole('button').first().click();\n  await expect(page.locator('body')).toHaveAttribute('data-last-action', 'clicked');\n});",
