    "spec": "# Dashboard Widget — Feature Task\nGoal: Team ko weekly progress ek glance me dikhana hai.\n## Required components\n- Weekly Progress (heading) — Widget heading\n- 72% complete (text) — Progress value\n- 72 (progress) — Progress bar\n- Tasks · 18/25 (row) — Task count row\n- View Report (button) — Report button\n## Interactions\n- View Report click par report section khule\n- Progress bar value text se match kare\n## Acceptance criteria\n- Progress percentage aur bar same value dikhayein\n- Widget chhoti screen par readable rahe\n- Button ka purpose clear ho",
    "code": "<section class=\"card\" aria-label=\"Dashboard Widget\">\n      <h2>Weekly Progress</h2>\n      <p>72% complete</p>\n      <div class=\"progress\" role=\"progressbar\" aria-valuenow=\"72\" aria-valuemin=\"0\" aria-valuemax=\"100\"><i style=\"width:72%\"></i></div>\n      <div class=\"row\"><span>Tasks · 18/25</span></div>\n      <button type=\"button\" data-action=\"view-report\">View Report</button>\n    </section>\n\n<style>\n.card{max-width:420px;border:1px solid #e4e7ec;border-radius:20px;padding:20px;font-family:system-ui}\n.card button{background:#2563eb;color:#fff;border:0;border-radius:12px;padding:11px 14px;font-weight:800}\n.card input{width:100%;padding:11px;border:1px solid #e4e7ec;border-radius:12px}\n.badge{background:#eff6ff;color:#1d4ed8;border-radius:999px;padding:5px 9px;font-weight:800}\n.progress{height:10px;background:#eef2ff;border-radius:999px;overflow:hidden}.progress i{display:block;height:100%;background:#2563eb}\n@media(max-width:520px){.card{max-width:100%}}\n</style>\n\n<script>\ndocument.querySelector('[data-action]')?.addEventListener('click', () => {\n  document.body.dataset.lastAction = 'clicked';\n});\n</script>",
    "tests": "import { test, expect } from '@playwright/test';\n\ntest('Dashboard Widget matches the mockup task', async ({ page }) => {\n  await page.goto('/');\n  await expect(page.getByText('Weekly Progress')).toBeVisible();\n  await expect(page.getByText('72% complete')).toBeVisible();\n  await expect(page.getByText('72')).toBeVisible();\n  await expect(page.getByText('Tasks · 18/25')).toBeVisible();\n  await expect(page.getByRole('button', { name: 'View Report' })).toBeVisible();\n});\n\ntest('primary action responds', async ({ page }) => {\n  await page.goto('/');\n  await page.getByRole('button').first().click();\n  await expect(page.locator('body')).toHaveAttribute('data-last-action', 'clicked');\n});",
