    "spec": "# Billing Card — Feature Task\nGoal: User ko current plan, amount due aur payment action ek saath dikhana hai.\n## Required components\n- Pro Plan (heading) — Plan name heading\n- ₹499/month (text) — Price text\n- Next bill · 1 Dec (row) — Billing date row\n- Active (badge) — Status badge\n- Pay Now (button) — Primary payment button\n## Interactions\n- Pay Now click par payment state change ho\n- Active badge hamesha visible rahe\n## Acceptance criteria\n- Plan name aur price clearly visible hon\n- Pay Now button keyboard se focus ho\n- Mobile width par card overflow na kare",
    "code": "<section class=\"card\" aria-label=\"Billing Card\">\n      <h2>Pro Plan</h2>\n      <p>₹499/month</p>\n      <div class=\"row\"><span>Next bill · 1 Dec</span></div>\n      <span class=\"badge\">Active</span>\n      <button type=\"button\" data-action=\"pay-now\">Pay Now</button>\n    </section>\n\n<style>\n.card{max-width:420px;border:1px solid #e4e7ec;border-radius:20px;padding:20px;font-family:system-ui}\n.card button{background:#2563eb;color:#fff;border:0;border-radius:12px;padding:11px 14px;font-weight:800}\n.card input{width:100%;padding:11px;border:1px solid #e4e7ec;border-radius:12px}\n.badge{background:#eff6ff;color:#1d4ed8;border-radius:999px;padding:5px 9px;font-weight:800}\n.progress{height:10px;background:#eef2ff;border-radius:999px;overflow:hidden}.progress i{display:block;height:100%;background:#2563eb}\n@media(max-width:520px){.card{max-width:100%}}\n</style>\n\n<script>\ndocument.querySelector('[data-action]')?.addEventListener('click', () => {\n  document.body.dataset.lastAction = 'clicked';\n});\n</script>",
    "tests": "import { test, expect } from '@playwright/test';\n\ntest('Billing Card matches the mockup task', async ({ page }) => {\n  await page.goto('/');\n  await expect(page.getByText('Pro Plan')).toBeVisible();\n  await expect(page.getByText('₹499/month')).toBeVisible();\n  await expect(page.getByText('Next bill · 1 Dec')).toBeVisible();\n  await expect(page.getByText('Active')).toBeVisible();\n  await expect(page.getByRole('button', { name: 'Pay Now' })).toBeVisible();\n});\n\ntest('primary action responds', async ({ page }) => {\n  await page.goto('/');\n  await page.getByRole('button').first().click();\n  await expect(page.locator('body')).toHaveAttribute('data-last-action', 'clicked');\n});",
